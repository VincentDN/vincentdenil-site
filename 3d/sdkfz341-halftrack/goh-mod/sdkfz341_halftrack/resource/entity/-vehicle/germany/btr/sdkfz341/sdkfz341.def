; Sd.Kfz.341 MRAP half-track IFV (WW2044) - entity definition, DRAFT.
;
; This file was written without access to the game's own files, in the classic
; GEM (Men of War) layout. Gates of Hell uses its own include macros and property
; names, so treat it as a checklist rather than a finished file:
;   1. unpack resource/entity/entity.pak and find the stock Sd.Kfz.251 folder,
;   2. copy ITS .def over this one,
;   3. re-apply the lines marked [341] below.
; See MODDING.md next to the mod folder for the full procedure.

{game_entity
	{extension "sdkfz341.mdl"}                 ; [341] our model

	; --- identity / mass -------------------------------------------------
	{props "vehicle" "wheeled" "tracked" "armored" "btr" "apc" "steel"}
	{mass 14500}                                ; [341] kg, MRAP hull + unmanned turret

	; --- armour by volume name (volumes are in sdkfz341.mdl) ---------------
	; values in mm: front, side, rear, top (check the stock file for the order it uses)
	{volume "body"        {thickness 30 20 14 10}}
	{volume "body_lower"  {thickness 20 14 14 12}}
	{volume "engine"      {thickness 30 20 14 10} {component "engine"}}
	{volume "turret"      {thickness 30 20 14 10} {component "turret"}}
	{volume "gun"         {thickness 20} {component "gun"}}
	{volume "trackl"      {thickness 10} {component "trackleft"}}
	{volume "trackr"      {thickness 10} {component "trackright"}}
	{volume "wheell"      {thickness 5}  {component "wheel"}}
	{volume "wheelr"      {thickness 5}  {component "wheel"}}

	; --- chassis: half-track (steered front axle, driven tracks) -----------
	; [341] bone names in the model:
	;   front wheels   wheell / wheelr   (children of steerl / steerr)
	;   road wheels    wheell1..4 / wheelr1..4
	;   sprockets      sprocketl / sprocketr      idlers  idlerl / idlerr
	;   return rollers rollerl1..2 / rollerr1..2  tracks  trackl / trackr
	{extender "chassis"
		{max_speed 62}                           ; km/h on road
		{steer_bones "steerl" "steerr" {max_angle 28}}
		{wheel_radius 12.0}                      ; front wheel, GEM units (0.60 m)
		{track_wheel_radius 6.0}                 ; road wheel (0.30 m)
	}

	; --- turret + weapons ----------------------------------------------------
	; turret bone "turret" (revolute, Z up), gun bone "gun" (revolute, -10..+45 deg),
	; recoiling barrel "gun_barrel" (prismatic), muzzle "foresight3", coax muzzle "foresight4"
	{weaponry
		{place "gun"   {turret "turret"} {gun "gun"} {foresight "foresight3"} {type "cannon"}}   ; [341] 30 mm MK30-2/ABM class
		{place "mgun"  {turret "turret"} {gun "gun"} {foresight "foresight4"} {type "mgun"}}     ; [341] coaxial MG
	}

	; --- crew and passengers ----------------------------------------------------
	; anchors in the model: seat_driver, seat_commander, seat1..seat8, emit_rear (dismount point)
	{boarder
		{link "driver"    "seat_driver"}
		{link "commander" "seat_commander"}        ; operates the unmanned turret from the hull
		{link "seat1" "seat1"} {link "seat2" "seat2"} {link "seat3" "seat3"} {link "seat4" "seat4"}
		{link "seat5" "seat5"} {link "seat6" "seat6"} {link "seat7" "seat7"} {link "seat8" "seat8"}
		{emit "emit_rear"}
		{door "rear" {open "ramp_open"} {close "ramp_close"}}       ; [341] sequences in the .mdl
		{door "hatch" {open "hatch_open"} {close "hatch_close"}}
	}

	; --- effects ---------------------------------------------------------------
	{bone "fx_exhaust"   {effect "exhaust"}}
	{bone "headlight_l"  {effect "headlight"}}
	{bone "headlight_r"  {effect "headlight"}}
	{bone "stoplight_l"  {effect "stoplight"}}
	{bone "stoplight_r"  {effect "stoplight"}}
	{bone "fx_smoke_l"   {effect "smoke_launcher"}}
	{bone "fx_smoke_r"   {effect "smoke_launcher"}}
}
